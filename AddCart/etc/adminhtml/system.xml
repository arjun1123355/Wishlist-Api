<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="sales" translate="label" type="text" sortOrder="300" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Sales</label>
            <tab>sales</tab>
            <resource>Magento_Sales::config_sales</resource>
            <group id="cart_restriction" translate="label" type="text" sortOrder="100" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Cart Restriction</label>

                <field id="enable" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable Feature</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Enable or disable cart restriction for guest and general customers</comment>
                </field>

                <field id="minimum_amount" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Minimum Product Amount</label>
                    <validate>validate-number validate-zero-or-greater</validate>
                    <comment>Minimum product price required to add to cart</comment>
                    <depends>
                        <field id="enable">1</field>
                    </depends>
                </field>

                <field id="error_message" translate="label" type="textarea" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Error Message</label>
                    <comment>Use {{amount}} to display minimum amount. Example: Product price must be at least {{amount}}</comment>
                    <depends>
                        <field id="enable">1</field>
                    </depends>
                </field>

            </group>
        </section>
    </system>
</config>
