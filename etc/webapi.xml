<?xml version="1.0"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">

    <route url="/V1/wishlist/add" method="POST">
        <service class="Codilar\WishList\Api\WishlistManagementInterface" method="addToWishlist"/>
        <resources>
            <resource ref="self"/>
        </resources>
    </route>

    <route url="/V1/wishlist/remove" method="POST">
        <service class="Codilar\WishList\Api\WishlistManagementInterface" method="removeFromWishlist"/>
        <resources>
            <resource ref="self"/>
        </resources>
    </route>

    <route url="/V1/wishlist/get" method="GET">
        <service class="Codilar\WishList\Api\WishlistManagementInterface" method="getWishlist"/>
        <resources>
            <resource ref="self"/>
        </resources>
    </route>

    <route url="/V1/wishlist/movetocart" method="POST">
        <service class="Codilar\WishList\Api\WishlistManagementInterface" method="moveToCart"/>
        <resources>
            <resource ref="self"/>
        </resources>
    </route>

    <route url="/V1/wishlist/movetowishlist" method="POST">
        <service class="Codilar\WishList\Api\WishlistManagementInterface" method="moveToWishlist"/>
        <resources>
            <resource ref="self"/>
        </resources>
    </route>

</routes>
